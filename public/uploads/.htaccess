# Prevent execution of any scripts in the uploads folder
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|phar|sh|exe|pl|py|cgi)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
