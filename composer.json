{
  "name": "ensan/charity-system",
  "type": "project",
  "description": "نظام إداري لمؤسسة إنسان الخيرية باستخدام Laravel و MySQL",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0",
    "laravel/tinker": "^2.10",
    "darkaonline/l5-swagger": "^10.1",
    "intervention/image": "^4.0",
    "dompdf/dompdf": "^3.1",
    "ext-gd": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "nunomaduro/collision": "^8.8",
    "mockery/mockery": "^1.6"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit"
  }
}
